# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OneSignal App ID & REST API Key for mobile & web push notifications
VITE_ONESIGNAL_APP_ID=
VITE_ONESIGNAL_REST_API_KEY=

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# Supabase URL & Anon Public Key (configured for deployed instances)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Resend API Key (server-side only, used by Express backend to send support and auto-reply emails)
RESEND_API_KEY=

